SECRET_KEY=dev-only-insecure-key-do-not-use-in-prod
DJANGO_SETTINGS_MODULE=config.settings.develop
ALLOWED_HOSTS=localhost,127.0.0.1
RATE_HOLD_MINUTES=30
DEFAULT_FROM_EMAIL=Обмін21 <noreply@example.com>
# Resend API key (Sending access). Leave empty to skip email notifications.
RESEND_API_KEY=
# From-address on a Resend-verified domain (falls back to DEFAULT_FROM_EMAIL).
EMAIL_FROM=
# Staff recipients for form notifications (comma-separated). Falls back to SiteSettings.notify_email.
NOTIFY_EMAIL_TO=
# Telegram BotFather token. Leave empty to skip Telegram notifications.
TELEGRAM_BOT_TOKEN=
# Staff Telegram chat id(s), comma-separated (group ids are negative). Falls back to SiteSettings.notify_telegram_chat_id.
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_BASE_URL=https://example.com
TELEGRAM_WEBHOOK_URL=
POSTGRES_DB=obmin21
POSTGRES_USER=obmin21
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
SECURE_SSL_REDIRECT=True
CSRF_TRUSTED_ORIGINS=https://example.com
